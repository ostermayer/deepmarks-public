# Box B — copy to .env on the box, fill in real values, chmod 600.
# NEVER commit the populated .env.

# ─── Archive worker Nostr identity ──────────────────────────────────────
# This pubkey must also appear in Box A's ARCHIVE_WORKER_PUBKEY so
# payment-proxy's dynamic Blossom auth gate allows archive uploads.
ARCHIVE_WORKER_NSEC=

# ─── Shared secret for worker → payment-proxy callbacks ─────────────────
# Match WORKER_CALLBACK_SECRET on Box A (same value in both .env files).
WORKER_CALLBACK_SECRET=

# BUD-04 mirror fanout targets. Primary is blossom.deepmarks.org; Primal
# is the default operator mirror. Users can add paid/trusted backup
# Blossom servers in app/extension settings per archive request.
BLOSSOM_MIRROR_URLS=https://blossom.primal.net

# Optional yt-dlp cookies — fixes YouTube "Sign in to confirm you're not a
# bot" on datacenter IPs. Export cookies.txt from a logged-in YouTube session
# (use a BURNER Google account — a datacenter IP + real cookies can flag it),
# drop the file on Box B, then set BOTH:
#   YTDLP_COOKIES_HOST_FILE = host path to the cookies file (compose mounts it
#                             read-only to /run/secrets/yt-cookies.txt)
#   YTDLP_COOKIES_FILE      = /run/secrets/yt-cookies.txt
# Leave both blank to run without cookies. Do not store user credentials here.
YTDLP_COOKIES_HOST_FILE=
YTDLP_COOKIES_FILE=

# ─── Residential last-ditch egress (optional, OFF by default) ────────────
# A WireGuard "wg" sidecar (deploy/box-b/wg-sidecar) owns the archive-worker's
# network namespace. When a YouTube download is STILL bot-walled on the
# datacenter IP after the cookie retry, the worker makes ONE last-ditch attempt
# out a residential tunnel by source-binding to the wg0 IP. Datacenter IP stays
# the default for everything else; the home line is used sparingly.
#   WG_SIDECAR_CONF             host path to the GL.iNet client profile rewritten
#                               with `Table = off` + a PostUp source rule
#                               (`ip rule from <wg0-ip> lookup <table>`); blank =
#                               no tunnel (worker runs datacenter-only).
#   RESIDENTIAL_EGRESS_SOURCE_IP  wg0 tunnel address, e.g. 10.66.0.2; blank = off.
#   RESIDENTIAL_ALWAYS_DOMAINS  optional comma list of hosts to send residential
#                               on the FIRST try; EMPTY = residential is
#                               fallback-only (the intended default).
WG_SIDECAR_CONF=
RESIDENTIAL_EGRESS_SOURCE_IP=
RESIDENTIAL_ALWAYS_DOMAINS=

# ─── Redis password (must match Box A) ──────────────────────────────────
REDIS_PASSWORD=
REDIS_PASSWORD_URLENC=
