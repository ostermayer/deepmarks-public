#!/usr/bin/env bash
# deepmarks-resource-check — host-level resource alerter.
#
# Runs on every box via cron (15 min). Alerts on:
#   - Disk > 80% on any non-tmpfs partition
#   - Memory > 90%
#   - Container restart count > 3 in last hour (per-container key)
#   - Box A backup/restore/Object Storage safety timers failed or stale
#   - Redis persistence reports failed RDB/AOF writes
#   - Blossom is not configured for S3 or is accumulating local blobs
#   - Voltage LND macaroon expiry < 30 days (Box A only — silent skip
#     when /etc/deepmarks-monitoring.env doesn't define VOLTAGE_MACAROON_PATH)

# This is a best-effort monitor: one failed probe or alert send should not
# stop the rest of the checks from running.
set -uo pipefail

DISK_PCT_LIMIT=80
MEM_PCT_LIMIT=90
RESTART_LIMIT=3
MACAROON_DAYS_WARN=30
BLOSSOM_LOCAL_BLOBS_MB_LIMIT=256
BACKUP_SERVICE_MAX_AGE_SECONDS=172800

ENV_FILE=/etc/deepmarks-monitoring.env
if [ -r "$ENV_FILE" ]; then
  set -a
  # shellcheck source=/etc/deepmarks-monitoring.env
  . "$ENV_FILE"
  set +a
fi

load_box_a_env_var() {
  local var="$1"
  local env_file="${BOX_A_ENV_FILE:-/opt/deepmarks-repo/deploy/box-a/.env}"
  if [ -n "${!var:-}" ] || [ ! -r "$env_file" ]; then
    return
  fi
  local value
  value="$(awk -F= -v key="$var" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$env_file" \
    | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")"
  if [ -n "$value" ]; then
    printf -v "$var" '%s' "$value"
  fi
}

send_alert() {
  deepmarks-alert "$@" || true
}

# ── disk ───────────────────────────────────────────────────────────────
df -P --output=source,pcent,target -x tmpfs -x devtmpfs -x squashfs 2>/dev/null \
| tail -n +2 | while read -r src pct mount; do
  pct_num="${pct%\%}"
  if [ "$pct_num" -ge "$DISK_PCT_LIMIT" ]; then
    send_alert warning "disk-$src" \
      "disk $mount at ${pct} on $(hostname)" \
      "Filesystem $src mounted at $mount is at $pct of capacity." \
      "Investigate large directories: du -sh $mount/* | sort -h | tail -10"
  fi
done

# ── memory ─────────────────────────────────────────────────────────────
mem_used_pct=$(free | awk '/^Mem:/ {printf "%d", ($2-$7)*100/$2}')
if [ "$mem_used_pct" -ge "$MEM_PCT_LIMIT" ]; then
  send_alert warning "mem-pressure" \
    "memory at ${mem_used_pct}% on $(hostname)" \
    "Available memory below threshold. Check 'docker stats' for the heaviest container."
fi

# ── container restart counts ──────────────────────────────────────────
if command -v docker >/dev/null 2>&1; then
  docker ps --format '{{.Names}}' | while read -r name; do
    [ -z "$name" ] && continue
    rc=$(docker inspect "$name" --format '{{.RestartCount}}' 2>/dev/null || echo 0)
    started=$(docker inspect "$name" --format '{{.State.StartedAt}}' 2>/dev/null || echo "")
    if [ -n "$started" ] && [ "$rc" -gt 0 ]; then
      # Only flag containers whose RestartCount climbed AND whose last
      # start was inside the last hour (so a long-stable container with
      # historical restarts doesn't keep alerting).
      started_epoch=$(date -d "$started" +%s 2>/dev/null || echo 0)
      now_epoch=$(date +%s)
      age=$(( now_epoch - started_epoch ))
      if [ "$rc" -ge "$RESTART_LIMIT" ] && [ "$age" -lt 3600 ]; then
        send_alert warning "restart-$name" \
          "container $name restarted $rc times" \
          "Container $name on $(hostname) has RestartCount=$rc and last started ${age}s ago." \
          "Last logs: docker logs --tail=50 $name"
      fi
    fi
  done
fi

# ── Box A data-durability checks ──────────────────────────────────────
if command -v docker >/dev/null 2>&1 && [ -d "${BOX_A_COMPOSE_DIR:-/opt/deepmarks-repo/deploy/box-a}" ]; then
  load_box_a_env_var REDIS_PASSWORD

  redis_container="$(docker ps --format '{{.Names}}' | grep -E '(^|-)redis-1$' | head -1 || true)"
  if [ -n "$redis_container" ] && [ -n "${REDIS_PASSWORD:-}" ]; then
    redis_info="$(docker exec "$redis_container" redis-cli -a "$REDIS_PASSWORD" --no-auth-warning INFO persistence 2>/dev/null | tr -d '\r' || true)"
    if [ -z "$redis_info" ]; then
      send_alert warning "redis-persistence-unreadable" \
        "Redis persistence status unreadable on $(hostname)" \
        "Could not run INFO persistence in $redis_container." \
        "Check container health and REDIS_PASSWORD in /etc/deepmarks-monitoring.env or Box A .env."
    else
      rdb_status="$(printf '%s\n' "$redis_info" | awk -F: '$1=="rdb_last_bgsave_status" {print $2; exit}' || true)"
      aof_status="$(printf '%s\n' "$redis_info" | awk -F: '$1=="aof_last_write_status" {print $2; exit}' || true)"
      loading="$(printf '%s\n' "$redis_info" | awk -F: '$1=="loading" {print $2; exit}' || true)"
      if [ "${rdb_status:-ok}" != "ok" ]; then
        send_alert critical "redis-rdb-persistence" \
          "Redis RDB persistence failing on $(hostname)" \
          "rdb_last_bgsave_status=${rdb_status:-missing}." \
          "Run: docker compose -f /opt/deepmarks-repo/deploy/box-a/compose.yml logs redis"
      fi
      if [ "${aof_status:-ok}" != "ok" ]; then
        send_alert critical "redis-aof-persistence" \
          "Redis AOF persistence failing on $(hostname)" \
          "aof_last_write_status=${aof_status:-missing}." \
          "Run: docker compose -f /opt/deepmarks-repo/deploy/box-a/compose.yml logs redis"
      fi
      if [ "${loading:-0}" != "0" ]; then
        send_alert warning "redis-loading" \
          "Redis is loading data on $(hostname)" \
          "Redis INFO persistence reports loading=${loading:-missing}; writes may be delayed until load completes."
      fi
    fi
  fi

  blossom_container="$(docker ps --format '{{.Names}}' | grep -E '(^|-)blossom-server-1$' | head -1 || true)"
  if [ -n "$blossom_container" ]; then
    blossom_cmd="$(docker inspect "$blossom_container" --format '{{json .Config.Cmd}}' 2>/dev/null || true)"
    if ! printf '%s' "$blossom_cmd" | grep -q '/app/config.yml'; then
      send_alert critical "blossom-config-missing" \
        "Blossom not started with /app/config.yml on $(hostname)" \
        "Container $blossom_container command is: ${blossom_cmd:-unknown}." \
        "Without the config file, blossom-server can fall back to local /app/data/blob storage."
    fi

    if ! docker exec "$blossom_container" sh -c 'test -r /app/config.yml && grep -Eq "backend:[[:space:]]*s3" /app/config.yml' >/dev/null 2>&1; then
      send_alert critical "blossom-s3-config" \
        "Blossom S3 backend config missing on $(hostname)" \
        "Container $blossom_container does not expose /app/config.yml with storage.backend: s3." \
        "Check deploy/box-a/blossom-config.yml and the compose volume mount."
    fi

    local_blob_mb="$(docker exec "$blossom_container" sh -c 'if [ -d /app/data/blobs ]; then du -sm /app/data/blobs 2>/dev/null | cut -f1; else echo 0; fi' 2>/dev/null || echo 0)"
    if [ "${local_blob_mb:-0}" -ge "$BLOSSOM_LOCAL_BLOBS_MB_LIMIT" ] 2>/dev/null; then
      send_alert critical "blossom-local-blobs" \
        "Blossom local blob storage is ${local_blob_mb} MB on $(hostname)" \
        "S3-backed Blossom should not accumulate large files in /app/data/blobs." \
        "Run: docker exec $blossom_container du -sh /app/data/blobs"
    fi
  fi
fi

# ── Box A backup / restore-test systemd timers ────────────────────────
backup_user="${BACKUP_SYSTEMD_USER:-dan}"
backup_unit_dir="/home/${backup_user}/.config/systemd/user"
if [ -d "$backup_unit_dir" ] && ls "$backup_unit_dir"/deepmarks-backup.timer >/dev/null 2>&1; then
  backup_uid="$(id -u "$backup_user" 2>/dev/null || true)"
  user_systemctl() {
    if [ -z "${backup_uid:-}" ] || [ ! -d "/run/user/${backup_uid}" ]; then
      return 1
    fi
    runuser -u "$backup_user" -- env XDG_RUNTIME_DIR="/run/user/${backup_uid}" systemctl --user "$@"
  }

  if ! user_systemctl list-timers deepmarks-backup.timer >/dev/null 2>&1; then
    send_alert warning "backup-systemd-unreadable" \
      "Cannot query Deepmarks backup timers on $(hostname)" \
      "The monitor could not access ${backup_user}'s user systemd manager." \
      "Check loginctl lingering and /run/user/${backup_uid:-<missing>}."
  else
    for timer in \
      deepmarks-backup.timer \
      deepmarks-backup-strfry.timer \
      deepmarks-restore-test.timer \
      deepmarks-object-storage-safety.timer
    do
      if [ -f "$backup_unit_dir/$timer" ] && ! user_systemctl is-active --quiet "$timer"; then
        send_alert critical "timer-$timer" \
          "Backup timer $timer inactive on $(hostname)" \
          "$timer is installed but not active." \
          "Run: systemctl --user status $timer"
      fi
    done

    for svc in \
      deepmarks-backup.service \
      deepmarks-backup-strfry.service \
      deepmarks-restore-test.service \
      deepmarks-object-storage-safety.service
    do
      [ -f "$backup_unit_dir/$svc" ] || continue
      if user_systemctl is-failed --quiet "$svc"; then
        send_alert critical "service-$svc" \
          "Backup service $svc failed on $(hostname)" \
          "$svc is in failed state." \
          "Run: journalctl --user -u $svc -n 120 --no-pager"
        continue
      fi

      exit_ts="$(user_systemctl show "$svc" -p ExecMainExitTimestamp --value 2>/dev/null || true)"
      if [ -n "$exit_ts" ]; then
        exit_epoch="$(date -d "$exit_ts" +%s 2>/dev/null || echo 0)"
        now_epoch="$(date +%s)"
        age=$(( now_epoch - exit_epoch ))
        if [ "$exit_epoch" -gt 0 ] && [ "$age" -gt "$BACKUP_SERVICE_MAX_AGE_SECONDS" ]; then
          send_alert warning "stale-$svc" \
            "Backup service $svc has not completed recently on $(hostname)" \
            "Last completion: $exit_ts (${age}s ago)." \
            "Run: systemctl --user list-timers deepmarks-*"
        fi
      fi
    done
  fi
fi

# ── voltage macaroon expiry (Box A only) ──────────────────────────────
# Macaroons issued by LND don't carry a built-in expiry by default; they
# expire when the LND-side caveats say so or when the operator rotates.
# We can't inspect the macaroon contents from here without lncli, so the
# simplest signal is "the file's mtime is older than N days" — which
# usually means it was last rotated then. Operator can ignore this if
# the macaroon is intentionally long-lived.
if [ -n "${VOLTAGE_MACAROON_PATH:-}" ] && [ -f "$VOLTAGE_MACAROON_PATH" ]; then
  age_days=$(( ( $(date +%s) - $(stat -c %Y "$VOLTAGE_MACAROON_PATH") ) / 86400 ))
  threshold=$(( 365 - MACAROON_DAYS_WARN ))
  if [ "$age_days" -ge "$threshold" ]; then
    send_alert info "voltage-macaroon-age" \
      "Voltage macaroon ${age_days} days old" \
      "Consider rotating before LND-side TTL hits, or confirm this macaroon is configured as long-lived."
  fi
fi

exit 0
