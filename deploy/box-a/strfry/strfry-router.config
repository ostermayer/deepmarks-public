# strfry router config — replaces the deprecated `strfry stream` CLI.
# One stream: push every newly-stored local event up to the VPC-only
# replica on Box B. Same semantics as the old
# `strfry stream ws://10.0.0.3:7777 --dir up`.
connectionTimeout = 20

streams {
    replica {
        dir = "up"
        urls = ["ws://10.0.0.3:7777"]
    }
}
