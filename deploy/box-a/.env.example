# Box A — copy to .env on the box, fill in real values, chmod 600.
# NEVER commit the populated .env.

# ─── Voltage (Lightning) ────────────────────────────────────────────────
# Use the gRPC socket (port 10009), not REST (8080).
VOLTAGE_REST_URL=your-node.m.voltageapp.io:10009
# Invoice-only macaroon, hex-encoded.  xxd -p invoice.macaroon | tr -d '\n'
VOLTAGE_INVOICE_MACAROON=

# ─── nsecBunker client (Box C talks NIP-46 over Box A's strfry) ─────────
# Payment-proxy doesn't hold the brand or personal nsec anymore; Box C
# does, inside nsecBunker. Payment-proxy authenticates to the bunker
# using an ephemeral client keypair (below). The bunker authorizes this
# pubkey to sign only specific kinds on specific identities. Rotate
# BUNKER_CLIENT_NSEC by generating a new pair + updating
# BUNKER_CLIENT_PUBKEY on Box C's .env + redeploying both.
BUNKER_CLIENT_NSEC=
# Ephemeral NSEC above derives to this pubkey. Put the same pubkey in
# Box C's BUNKER_CLIENT_PUBKEY. Generate fresh with:
#   node -e "const {getPublicKey,generateSecretKey,nip19}=require('nostr-tools'); \
#            const sk=generateSecretKey(); \
#            console.log('nsec:',nip19.nsecEncode(sk),'\npub:',getPublicKey(sk))"
BUNKER_RELAY_URL=ws://strfry:7777
# Legacy signer role name. In production this is the admin/operational
# npub10jeec... key that signs zap@ receipts, lifetime labels, and seeded
# operational bookmarks. It is not the public brand/social Damus key.
BUNKER_BRAND_PUBKEY=
BUNKER_PERSONAL_PUBKEY=

# Public brand/social key used for NIP-89 and relay social-kind privileges.
# Production default: npub199z...
DEEPMARKS_PUBLIC_BRAND_PUBKEY=2944e915ba71cf0fc19f5dda048ce053a87c01fd7478b179330a17edca4ce2f4
# Optional override for the daily Pinboard/landing-feed bookmark author.
# Defaults in code to the public brand/social npub199z... key.
DEEPMARKS_SEEDER_PUBKEY=2944e915ba71cf0fc19f5dda048ce053a87c01fd7478b179330a17edca4ce2f4

# ─── JWT signing for API keys ───────────────────────────────────────────
JWT_SECRET=

# ─── Object storage (Linode bucket) ─────────────────────────────────────
S3_ENDPOINT=https://us-southeast-1.linodeobjects.com
S3_REGION=us-southeast-1
S3_BUCKET=deepmarks
# Separate public-read bucket for cached site favicons. Keep distinct from
# the main bucket because favicons are served unauthenticated via redirect.
FAVICON_BUCKET=deepmarks-favicons
# Public base URL the /favicon endpoint redirects browsers to. If unset
# we derive it from S3_ENDPOINT + FAVICON_BUCKET (virtual-host style).
FAVICON_PUBLIC_BASE=
# Private bucket for passkey-encrypted user nsec ciphertext. The server
# never holds decryption keys — these blobs are AES-GCM ciphertext
# encrypted with a key derived from each user's passkey via WebAuthn PRF.
LINODE_CIPHERTEXT_BUCKET=ciphertext
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=

# ─── Passkey / WebAuthn relying party ──────────────────────────────────
# Must match the origin of the frontend that calls navigator.credentials.*.
# Defaults to deepmarks.org / https://deepmarks.org — override on staging.
PASSKEY_RP_ID=deepmarks.org
PASSKEY_RP_NAME=Deepmarks
PASSKEY_ORIGIN=https://deepmarks.org

# Public browser/self URL used in Atom feed metadata. api's
# PUBLIC_BASE_URL is fixed to api.deepmarks.org in compose for NIP-98
# and callback validation; feeds should still point readers at the site.
FEED_PUBLIC_BASE_URL=https://deepmarks.org

# ─── Blossom archive worker pubkey (hex) ───────────────────────────────
# Caddy/api always allows this key to write archives to Blossom.
# Lifetime users and standalone Blossom buyers are allowed dynamically.
ARCHIVE_WORKER_PUBKEY=

# ─── Archive worker callback secret ─────────────────────────────────────
# Shared with archive-worker on Box B. api uses this to verify
# HMAC on /archive/callback. MUST match the same key on Box B's .env or
# every archive job's terminal status update is dropped (route 503s).
# Generate with: openssl rand -hex 32
WORKER_CALLBACK_SECRET=

# ─── Redis ──────────────────────────────────────────────────────────────
# REDIS_PASSWORD: raw value used by redis-server --requirepass
# REDIS_PASSWORD_URLENC: same value, URL-encoded for the redis:// URL
#   (only differs if your password contains URL-unsafe chars).
REDIS_PASSWORD=
REDIS_PASSWORD_URLENC=

# ─── Meilisearch ────────────────────────────────────────────────────────
MEILI_MASTER_KEY=

# ─── LLM augmentation (optional, DeepInfra) ──────────────────────────────
# Leave DEEPINFRA_TOKEN empty to disable all LLM calls. When enabled,
# api enforces an open-source-only model allowlist; unapproved
# model overrides disable the LLM client at startup.
DEEPINFRA_TOKEN=
DEEPINFRA_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEEPINFRA_RESCUE_MODEL=deepseek-ai/DeepSeek-V4-Pro
DEEPINFRA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
# Timeout for the fast native calls (embeddings / rerank).
DEEPINFRA_TIMEOUT_MS=8000
# Separate, slightly longer ceiling for chat completions — DeepInfra has
# occasional latency spikes and the 8s native timeout was dropping enrichment
# jobs on those spikes. Healthy chat calls still return in 1–3s.
DEEPINFRA_CHAT_TIMEOUT_MS=20000
# Optional fast fallback for chat completions when DeepInfra times out / errors
# (Cerebras, OpenAI-compatible). gpt-oss-120b is open-weight and supports strict
# json_schema; with reasoning_effort=low it returns in ~1s. Leave CEREBRAS_TOKEN
# unset to disable the fallback. Rescue/enrichment stay on DeepInfra as primary.
CEREBRAS_TOKEN=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_CHAT_MODEL=gpt-oss-120b
# Live web search used by public archive rescue. Default is the private
# SearXNG service in compose; set provider=brave + BRAVE_SEARCH_API_KEY
# if you want to use Brave's API instead.
ARCHIVE_RESCUE_SEARCH_PROVIDER=searxng
ARCHIVE_RESCUE_SEARCH_URL=http://searxng:8080/search
ARCHIVE_RESCUE_SEARCH_TIMEOUT_MS=6000
ARCHIVE_RESCUE_SEARCH_MAX_RESULTS=10
BRAVE_SEARCH_API_KEY=
# ─── Internet Archive "Save Page Now" (optional, OFF by default) ─────────
# Best-effort: when a public lifetime webpage archive is enqueued, and when a
# webpage capture fails (bot-wall/timeout), also ask the Internet Archive to
# capture the page. IA crawls from its own infra, so it often succeeds where
# Box B's datacenter renderer is blocked; the rescue pass already consults
# Wayback, so a fresh snapshot feeds it. Public webpages only — never private/
# encrypted archives or the media add-on.
WAYBACK_SPN_ENABLED=
# Optional archive.org S3-style key "accesskey:secret" for authenticated SPN
# (async job_id + much higher rate limits). Blank = anonymous (heavily
# rate-limited). Keys: https://archive.org/account/s3.php
WAYBACK_SPN_S3_KEY=
# Kill switch for the LLM client even if a token is configured.
LLM_ENABLED=1
# One-shot existing-bookmark augmentation. Keep off for normal deploys;
# set to 1 only when intentionally backfilling the current Meilisearch corpus.
LLM_BACKFILL_EXISTING_BOOKMARKS=0
LLM_BACKFILL_PAGE_SIZE=100
LLM_BACKFILL_DELAY_MS=250
# Internal Qdrant ANN vector index for fast public semantic search.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=deepmarks_bookmarks_semantic
QDRANT_TIMEOUT_MS=5000

# ─── CORS for the frontend ──────────────────────────────────────────────
# Comma-separated origins. The frontend lives on Cloudflare Pages — both
# the bare apex (after CF Pages takes deepmarks.org) and the .pages.dev
# preview URL should be allowed. Add other previews as needed.
CORS_ORIGIN=https://deepmarks.org,https://deepmarks.pages.dev,capacitor://localhost,https://localhost

# ─── Operational email (Resend) — admin notifications only ─────────────
# Used to notify the operator on CSAM / abuse reports. Leave unset in
# dev; api logs email messages to stdout when no key is set.
RESEND_API_KEY=
EMAIL_FROM=Deepmarks <noreply@deepmarks.org>
# Addresses that receive abuse / CSAM notifications. Default to the
# deepmarks.org aliases if unset.
EMAIL_ABUSE=
EMAIL_CSAM=

# ─── BTCPay (lifetime-tier invoicing) ───────────────────────────────────
# Leave empty to disable the lifetime upgrade flow.
BTCPAY_URL=https://btcpay.example.com
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
