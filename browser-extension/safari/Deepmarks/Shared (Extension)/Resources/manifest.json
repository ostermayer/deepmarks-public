{
  "manifest_version": 3,
  "name": "Deepmarks",
  "version": "2.2.4",
  "description": "Save bookmarks to deepmarks.org and Nostr relays.",
  "icons": {
    "16": "icons/pennant-16.png",
    "32": "icons/pennant-32.png",
    "48": "icons/pennant-48.png",
    "128": "icons/pennant-128.png"
  },
  "action": {
    "default_title": "Deepmarks — save bookmark",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/pennant-16.png",
      "32": "icons/pennant-32.png"
    }
  },
  "background": {
    "scripts": [
      "assets/index.ts.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/nip07-provider.ts.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "js": [
        "assets/nip07-bridge.ts.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*/*"
      ],
      "resources": [
        "pennant.svg",
        "assets/nip07-provider.ts.js",
        "assets/nip07-bridge.ts.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
