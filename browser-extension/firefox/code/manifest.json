{
  "manifest_version": 3,
  "name": "Deepmarks",
  "version": "1.3.1",
  "description": "Save bookmarks to deepmarks.org and Nostr relays.",
  "icons": {
    "16": "icons/pennant-16.png",
    "32": "icons/pennant-32.png",
    "48": "icons/pennant-48.png",
    "128": "icons/pennant-128.png"
  },
  "action": {
    "default_title": "Deepmarks — save bookmark",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/pennant-16.png",
      "32": "icons/pennant-32.png"
    }
  },
  "background": {
    "scripts": [
      "service-worker-loader.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/nip07-provider.ts-CAJi0ktw.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "js": [
        "assets/nip07-bridge.ts-C64LibL4.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*/*"
      ],
      "resources": [
        "pennant.svg",
        "assets/nip07-provider.ts-CAJi0ktw.js",
        "assets/nip07-bridge.ts-C64LibL4.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@deepmarks.org",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
