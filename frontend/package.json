{
  "name": "@deepmarks/frontend",
  "version": "2.2.3",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:apple": "VITE_APPLE_BUILD=1 vite build",
    "preview": "vite preview",
    "ios:sync": "npm run build:apple && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.1.16",
    "svelte-check": "^4.0.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/vt323": "^5.2.7",
    "@noble/hashes": "^1.5.0",
    "@noble/secp256k1": "^2.1.0",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@nostr-dev-kit/ndk-cache-dexie": "^2.6.44",
    "@nostrify/nostrify": "^0.52.0",
    "@scure/base": "^1.2.6",
    "jsqr": "^1.4.0",
    "light-bolt11-decoder": "^3.2.0",
    "lucide-svelte": "^0.460.0",
    "nostr-tools": "^2.10.4",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  }
}
