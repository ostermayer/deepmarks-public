<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom URL scheme: deepmarks://save?url=…
                 Used by future deep links from notifications, web
                 fallbacks, and other apps that know our scheme. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deepmarks" />
            </intent-filter>

            <!-- NIP-46 mobile pairing links. Clients can open
                 nostrconnect://… directly into the app; the JS deep-link
                 router sends the original URI to /app/mobile-signer. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrconnect" />
                <data android:scheme="bunker" />
            </intent-filter>

            <!-- NIP-55 Android signer intents. Native Android Nostr
                 clients launch nostrsigner:… with startActivityForResult;
                 MainActivity stores the request and returns result extras
                 after the Svelte review screen approves it. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostrsigner" />
            </intent-filter>

            <!-- Android App Links (web → app on /app/save). Pairs with
                 /.well-known/assetlinks.json on deepmarks.org. The
                 SHA-256 fingerprint in that file gates which signing
                 key Android trusts to handle these URLs; until the
                 release key is generated and the fingerprint pasted
                 in, autoVerify will fail and the URL falls back to
                 the chooser. That's the right behavior — non-app
                 users get the website. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="deepmarks.org"
                      android:pathPrefix="/app/save" />
            </intent-filter>

            <!-- Share-sheet receiver. Browsers and other apps fire
                 ACTION_SEND with EXTRA_TEXT carrying the URL the user
                 wants to bookmark. Capacitor's MainActivity catches
                 this; we forward the URL into the SvelteKit /app/save
                 route from the JS side via the App plugin's
                 appUrlOpen event after a small bridge in MainActivity
                 (see MainActivity.java; bridge added when share is
                 first wired up). text/plain because Chrome / Firefox
                 / most browsers share the URL as plaintext, not as a
                 specific URL MIME. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
